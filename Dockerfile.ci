# syntax=docker/dockerfile:1
# CI multi-arch build: `dist/` is injected via the named "dist" build context
# (already compiled natively on the runner). No esbuild/vite runs under QEMU,
# avoiding the esbuild "service was stopped: write EPIPE" crash on emulated archs.
# The dist artifacts (vite static UI + server.cjs bundle) are pure JS and
# arch-independent; only the Bun runtime comes from the per-arch base image.

# ---------- Stage 1: Runtime deps ----------
# express + its deps are pure JS, so npm install is safe even under QEMU.
FROM node:20-alpine AS deps
WORKDIR /deps
RUN npm init -y >/dev/null \
    && npm install --omit=dev --omit=optional --no-audit --no-fund express@4.21.2 selfsigned@2.4.1 undici@7.29.0 \
    && npm cache clean --force

# ---------- Stage 2: Runtime (Node) ----------
FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# "dist" is a build context defined by docker/build-push-action (build-contexts).
COPY --from=dist / ./dist
COPY --from=deps /deps/node_modules ./node_modules

# Non-root runtime user + su-exec, so the entrypoint can prepare /app/data
# (mkdir + chown even when it's a host bind mount owned by another UID) and
# then drop privileges back to the relay user.
RUN addgroup -S relay && adduser -S -G relay relay \
    && chown -R relay:relay /app \
    && apk add --no-cache su-exec

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Fresh containers (no data mount) bind 0.0.0.0:3000 by default
# (DEFAULT_SERVER_CONFIG). Override via RELAY_PORT/PORT env or a mounted
# config file.

VOLUME ["/app/data"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "dist/server.cjs"]
